<?xml version="1.0" encoding="utf-8"?>
<UIX xmlns="http://schemas.microsoft.com/2007/uix" xmlns:crossfade="assembly://ZuneCrossfadeBridge/ZuneCrossfade" xmlns:slider="res://UIXControls!Slider.uix" xmlns:iris="assembly://UIX/Microsoft.Iris" xmlns:zuneUI="assembly://ZuneShell/ZuneUI" xmlns:styles="res://ZuneShellResources!Styles.uix" xmlns:button="res://UIXControls!Button.uix" xmlns:spreadSheet="res://UIXControls!SpreadSheet.uix" xmlns:radioButton="res://UIXControls!RadioButton.uix" xmlns:label="res://UIXControls!Label.uix" xmlns:util="assembly://ZuneDBApi/Microsoft.Zune.Util" xmlns:dialog="res://UIXControls!Dialog.uix" xmlns:checkbox="res://UIXControls!Checkbox.uix" xmlns:aboutDialog="res://ZuneShellResources!AboutDialog.uix" xmlns:managementGeneral="res://ZuneShellResources!ManagementGeneral.uix" xmlns:configuration="assembly://ZuneDBApi/Microsoft.Zune.Configuration" xmlns:management="res://ZuneShellResources!Management.uix">
  <UI Name="Default">
    <Properties>
      <zuneUI:CategoryPage Name="Page" CategoryPage="$Required" />
    </Properties>
    <Locals>
      <iris:Command Name="CheckNowButtonModel" Description="{zuneUI:Shell.LoadString(zuneUI:StringId.IDS_CHECK_FOR_UPDATE_BUTTON)}" />
      <iris:Command Name="ResetWarningMessageButtonModel" Description="{zuneUI:Shell.LoadString(zuneUI:StringId.IDS_RESET_WARNINGS_BUTTON)}" />
      <iris:Command Name="AboutZuneModel" Description="{zuneUI:Shell.LoadString(zuneUI:StringId.IDS_ABOUT)}" />
      <aboutDialog:AboutDialog Name="AboutDialog" />
      <styles:LabelStyle Name="StyleWarn" Color="{styles:Styles.TextActive}" Font="{styles:Styles.SettingsText}" />
      <iris:BooleanChoice Name="AutoLaunchZuneOnConnectCheckboxModel" Description="{zuneUI:Shell.LoadString(zuneUI:StringId.IDS_LAUNCH_ON_ZUNE_CONNECT)}" Value="{zuneUI:ZuneShell.DefaultInstance.Management.AutoLaunchZuneOnConnect}" />
    <iris:BooleanChoice Name="CrossfadeToggle" Description="Turn on crossfading" Value="{crossfade:Settings.SelectedEnabled}" />
<iris:Choice Name="CrossfadeDuration"><Options><String String="0 seconds" /><String String="1 seconds" /><String String="2 seconds" /><String String="3 seconds" /><String String="4 seconds" /><String String="5 seconds" /><String String="6 seconds" /><String String="7 seconds" /><String String="8 seconds" /><String String="9 seconds" /><String String="10 seconds" /></Options><ChosenIndex><Int32 Int32="{crossfade:Settings.SelectedSeconds}" /></ChosenIndex></iris:Choice></Locals>
    <Scripts><Script>crossfade:Settings.Track(CrossfadeToggle, CrossfadeDuration);</Script>
<Script>[DeclareTrigger(CrossfadeDuration.ChosenIndex)]
CrossfadeDescription.Content = crossfade:Settings.Description(CrossfadeDuration.ChosenIndex);</Script>
      <Script><![CDATA[
[DeclareTrigger(zuneUI:SoftwareUpdates.Instance.CheckingForUpdates)]
bool checking = zuneUI:SoftwareUpdates.Instance.CheckingForUpdates;
CheckNowButtonModel.Available = !checking;
Checking.Visible = checking;
]]></Script>
      <Script><![CDATA[
if (zuneUI:ZuneShell.DefaultInstance.Management.StartupPageChoice.Options.Count < 2)
{
    StartupPagePanel.Visible = false;
}
]]></Script>
      <Script><![CDATA[
[DeclareTrigger(AutoLaunchZuneOnConnectCheckboxModel.Value)]
zuneUI:ZuneShell.DefaultInstance.Management.AutoLaunchZuneOnConnect = AutoLaunchZuneOnConnectCheckboxModel.Value;
]]></Script>
      <Script><![CDATA[
[DeclareTrigger(ResetWarningMessageButtonModel.Invoked)]
zuneUI:ZuneShell.DefaultInstance.Management.ResetWarningMessages();
]]></Script>
      <Script><![CDATA[
[DeclareTrigger(CheckNowButtonModel.Invoked)]
zuneUI:SoftwareUpdates.Instance.CheckForUpdates(true);
]]></Script>
      <Script><![CDATA[
[DeclareTrigger(zuneUI:SoftwareUpdates.Instance.LastUpdateCheckResult)]
zuneUI:SoftwareUpdates.Instance.ShowUpdateAvailabilityDialog();
]]></Script>
      <Script><![CDATA[
[DeclareTrigger(AboutZuneModel.Invoked)]
AboutDialog.Show();
]]></Script>
    </Scripts>
    <Content>
      <Panel>
        <Layout>
          <FlowLayout Orientation="Vertical" Spacing="4, 0" DefaultChildAlignment="Near, Unspecified" />
        </Layout>
        <Children>
          <management:Label Content="{zuneUI:Shell.LoadString(zuneUI:StringId.IDS_GENERAL_INFORMATION_HEADER)}" Margins="0, 0, 0, 3" />
          <button:ActionButton Name="AboutZuneButton" Model="{AboutZuneModel}" Padding="-2, 0, 0, 0" />
          <Panel Name="StartupPagePanel" Layout="VerticalFlow" Margins="0, 15, 0, 0">
            <Children>
              <management:Label Name="StartupPageTitle" Content="{zuneUI:Shell.LoadString(zuneUI:StringId.IDS_VIEW_STARTUPPAGE_TITLE)}" />
              <label:Label Name="StartupPageHeader" Style="{styles:SharedStyles.SettingsBodyStyle}" WordWrap="true" Content="{zuneUI:Shell.LoadString(zuneUI:StringId.IDS_VIEW_STARTUPPAGE_HEADER)}" Padding="0, 3, 0, 4" />
              <radioButton:RadioGroup Name="StartupPageRadioGroup" Model="{zuneUI:ZuneShell.DefaultInstance.Management.StartupPageChoice}" AccessibleDescription="{zuneUI:Shell.LoadString(zuneUI:StringId.IDS_VIEW_STARTUPPAGE_TITLE)}" />
            </Children>
          </Panel>
          <management:CheckBox Model="{AutoLaunchZuneOnConnectCheckboxModel}" Margins="0, 15, 0, 0" />
          <management:Label Content="{zuneUI:Shell.LoadString(zuneUI:StringId.IDS_VIEW_WARNINGS_TITLE)}" Margins="0, 15, 0, 0" />
          <label:Label Style="{styles:SharedStyles.SettingsBodyStyle}" WordWrap="true" Content="{zuneUI:Shell.LoadString(zuneUI:StringId.IDS_VIEW_WARNINGS_HEADER)}" Padding="0, 3, 0, 4" />
          <button:ActionButton Name="ResetWarningMessageButton" Model="{ResetWarningMessageButtonModel}" TileMinSize="125, 0" Padding="-2, 0, 0, 0" />
          <management:Label Content="{zuneUI:Shell.LoadString(zuneUI:StringId.IDS_CHECK_FOR_UPDATES_TITLE)}" Margins="0, 15, 0, 3" />
          <Panel Layout="HorizontalFlow">
            <Children>
              <button:ActionButton Name="CheckNowButton" Model="{CheckNowButtonModel}" TileMinSize="105, 0" Padding="-2, 0, 0, 0" />
              <label:Label Name="Checking" Style="{styles:SharedStyles.SettingsBodyStyle}" Content="{zuneUI:Shell.LoadString(zuneUI:StringId.IDS_CHECKING_FOR_UPDATES)}" Margins="15, 1, 0, 0" />
            </Children>
          </Panel>
          <management:Label Content="{zuneUI:Shell.LoadString(zuneUI:StringId.IDS_SOUNDS_TITLE)}" Margins="0, 15, 0, 3" />
          <checkbox:CheckBox Model="{zuneUI:ZuneShell.DefaultInstance.Management.PlaySounds}" LabelFont="{styles:Styles.SettingsText}" LabelColor="{styles:Styles.SettingsTextActive}" />
          <management:Label Content="Crossfading" Margins="0, 20, 0, 3" />
<label:Label Content="Fade out the current track while the next fades in. Applies to local audio; repeat one plays without overlap." Style="{styles:SharedStyles.SettingsBodyStyle}" WordWrap="true" Padding="0, 3, 0, 8" />
<management:CheckBox Model="{CrossfadeToggle}" />
<slider:LabeledChoiceSlider Model="{CrossfadeDuration}" AccessibleDescription="Crossfade overlap duration" FilledBackgroundImage="{styles:Styles.SliderFill}" MinValueString="0 seconds" MaxValueString="10 seconds" TextStyle="{styles:SharedStyles.SettingsBodyStyle}" Margins="0, 8, 0, 0" />
<label:Label Name="CrossfadeDescription" Content="{crossfade:Settings.Description(CrossfadeDuration.ChosenIndex)}" Style="{styles:SharedStyles.SettingsBodyStyle}" WordWrap="true" />
<managementGeneral:TaskbarOptions Page="{Page}" />
          <management:Label Content="{zuneUI:Shell.LoadString(zuneUI:StringId.IDS_COMPACT_MODE_SETTINGS_TITLE)}" Margins="0, 15, 0, 3" />
          <checkbox:CheckBox Model="{zuneUI:ZuneShell.DefaultInstance.Management.CompactModeAlwaysOnTop}" LabelFont="{styles:Styles.SettingsText}" LabelColor="{styles:Styles.SettingsTextActive}" />
        </Children>
      </Panel>
    </Content>
  </UI>
  <UI Name="RatingsRadioButtonCell" Base="spreadSheet:Cell">
    <Properties>
      <zuneUI:RichLayoutCommand Name="Model" RichLayoutCommand="$Required" />
    </Properties>
    <Locals>
      <zuneUI:Management Name="Management" Management="{zuneUI:ZuneShell.DefaultInstance.Management}" />
    </Locals>
    <Scripts>
      <Script><![CDATA[
CheckBox.Visible = Model.HasRichLayout;
]]></Script>
      <Script><![CDATA[
[DeclareTrigger(Management.RatingsChoice.Value)]
CheckBox.Available = !Management.RatingsChoice.Value && !configuration:ClientConfiguration.MediaStore.SharedUserRatings;
]]></Script>
    </Scripts>
    <Content>
      <Panel Layout="VerticalFlow" Padding="0, 0, 10, 0">
        <Children>
          <label:Label Name="Label" Content="{Model.Description}" Style="{Style}" Padding="0, 0, 0, 5" WordWrap="true" />
          <management:CheckBox Name="CheckBox" Model="{zuneUI:ZuneShell.DefaultInstance.Management.ApplyRatingsChoice}" LabelColor="{styles:Styles.SettingsTextActive}" Margins="-2, 0, 0, 0" />
        </Children>
      </Panel>
    </Content>
  </UI>
  <UI Name="TaskbarOptions">
    <Properties>
      <zuneUI:CategoryPage Name="Page" CategoryPage="$Required" />
    </Properties>
    <Locals>
      <iris:Command Name="ConfigureToolbarOnXPCommand" Description="{zuneUI:Shell.LoadString(zuneUI:StringId.IDS_TASKBAR_SETUP_ON_XP)}" />
      <iris:Command Name="EnableToolbarOnVistaCommand" Description="{zuneUI:Shell.LoadString(zuneUI:StringId.IDS_TASKBAR_ENABLE_ON_VISTA)}" />
      <iris:Command Name="DisableToolbarOnVistaCommand" Description="{zuneUI:Shell.LoadString(zuneUI:StringId.IDS_TASKBAR_DISABLE_ON_VISTA)}" />
      <util:TaskbarPlayer Name="TaskbarPlayer" TaskbarPlayer="{util:TaskbarPlayer.Instance}" />
      <Timer Name="VistaRefreshTimer" AutoRepeat="true" Interval="1000" Enabled="false" />
      <Timer Name="MinimizeTimer" AutoRepeat="false" Interval="1000" Enabled="false" />
      <Window Name="Window" />
    </Locals>
    <Scripts>
      <Script><![CDATA[
if (zuneUI:OSVersion.IsXP())
{
    ConfigureToolbarDesc.Visible = true;
    ConfigureToolbarOnXP.Visible = true;
}
else
{
    if (zuneUI:OSVersion.IsVista())
    {
        ConfigureToolbarDesc.Visible = true;
        bool toolbarEnabled = TaskbarPlayer.EnableToolbar;
        EnableToolbarOnVista.Visible = !toolbarEnabled;
        DisableToolbarOnVista.Visible = toolbarEnabled;
        VistaRefreshTimer.Start();
    }
    else
    {
        if (zuneUI:OSVersion.IsWin7())
        {
            Root.Visible = false;
        }
    }
}
]]></Script>
      <Script><![CDATA[
[DeclareTrigger(ConfigureToolbarOnXPCommand.Invoked)]
managementGeneral:ConfigureTaskbarDialog dialog = new managementGeneral:ConfigureTaskbarDialog();
dialog.Show();
]]></Script>
      <Script><![CDATA[
[DeclareTrigger(EnableToolbarOnVistaCommand.Invoked)]
TaskbarPlayer.EnableToolbar = true;
VistaRefreshTimer.Start();
MinimizeTimer.Start();
]]></Script>
      <Script><![CDATA[
[DeclareTrigger(MinimizeTimer.Tick)]
Window.WindowState = WindowState.Minimized;
]]></Script>
      <Script><![CDATA[
[DeclareTrigger(DisableToolbarOnVistaCommand.Invoked)]
TaskbarPlayer.EnableToolbar = false;
DisableToolbarOnVistaCommand.Available = false;
VistaRefreshTimer.Start();
]]></Script>
      <Script><![CDATA[
[DeclareTrigger(VistaRefreshTimer.Tick)]
bool toolbarEnabled = TaskbarPlayer.EnableToolbar;
EnableToolbarOnVista.Visible = !toolbarEnabled;
DisableToolbarOnVista.Visible = toolbarEnabled;
DisableToolbarOnVistaCommand.Available = true;
]]></Script>
    </Scripts>
    <Content>
      <Panel Name="Root">
        <Layout>
          <FlowLayout Orientation="Vertical" Spacing="4, 0" DefaultChildAlignment="Near, Unspecified" />
        </Layout>
        <Children>
          <management:Label Content="{zuneUI:Shell.LoadString(zuneUI:StringId.IDS_TASKBAR_SETTINGS_TITLE)}" Margins="0, 15, 0, 3" />
          <label:Label Name="ConfigureToolbarDesc" Content="{zuneUI:Shell.LoadString(zuneUI:StringId.IDS_TASKBAR_SETTINGS_DESC)}" Style="{styles:SharedStyles.DialogTextStyle}" WordWrap="true" Padding="0, 4, 0, 4" Visible="false" />
          <button:ActionButton Name="ConfigureToolbarOnXP" Model="{ConfigureToolbarOnXPCommand}" Padding="-2, 0, 0, 0" Visible="false" />
          <button:ActionButton Name="EnableToolbarOnVista" Model="{EnableToolbarOnVistaCommand}" Padding="-2, 0, 0, 0" Visible="false" />
          <button:ActionButton Name="DisableToolbarOnVista" Model="{DisableToolbarOnVistaCommand}" Padding="-2, 0, 0, 0" Visible="false" />
        </Children>
      </Panel>
    </Content>
  </UI>
  <Class Name="ConfigureTaskbarDialog" Base="dialog:Dialog">
    <Properties>
      <Command Name="OnClose" Command="{null}" />
      <iris:Command Name="Close" Description="{zuneUI:Shell.LoadString(zuneUI:StringId.IDS_CLOSE_BUTTON)}" />
    </Properties>
    <Scripts>
      <Script><![CDATA[
if (zuneUI:OSVersion.IsXP())
{
    ContentUI = "res://ZuneShellResources!ManagementGeneral.uix#ConfigureTaskbarOnXPDialogContentUI";
}
else
{
    ContentUI = "res://ZuneShellResources!ManagementGeneral.uix#ConfigureTaskbarOnVistaDialogContentUI";
}
]]></Script>
      <Script><![CDATA[
[DeclareTrigger(Close.Invoked)]
this.Hide();
if (OnClose != null)
{
    OnClose.Invoke();
}
]]></Script>
    </Scripts>
  </Class>
  <UI Name="ConfigureTaskbarOnXPDialogContentUI" Base="dialog:DialogContentUI">
    <Properties>
      <managementGeneral:ConfigureTaskbarDialog Name="Dialog" ConfigureTaskbarDialog="$Required" />
    </Properties>
    <Scripts>
      <Script><![CDATA[
DialogTitle = zuneUI:Shell.LoadString(zuneUI:StringId.IDS_TASKBAR_SETUP_ON_XP_TITLE);
ButtonCommands = new List();
ButtonCommands.Add(Dialog.Close);
ButtonModelToFocus = Dialog.Close;
DefaultButtonModel = Dialog.Close;
]]></Script>
    </Scripts>
    <Content>
      <Panel Layout="VerticalFlow" MaximumSize="475, 0">
        <Children>
          <label:Label Content="{zuneUI:Shell.LoadString(zuneUI:StringId.IDS_TASKBAR_SETUP_ON_XP_DESC)}" Style="{styles:SharedStyles.DialogTextStyle}" WordWrap="true" Padding="0, 4, 0, 4" />
          <Graphic Content="res://ZuneShellResources!TaskbarPlayer.XP.png" Margins="0, 4, 0, 4" />
          <management:Label Content="{zuneUI:Shell.LoadString(zuneUI:StringId.IDS_TASKBAR_SETUP_ON_XP_HOWTO_LABEL)}" WordWrap="false" Padding="0, 14, 0, 4" />
          <label:Label Content="{zuneUI:Shell.LoadString(zuneUI:StringId.IDS_TASKBAR_SETUP_ON_XP_HOWTO_DESC)}" Style="{styles:SharedStyles.DialogTextStyle}" WordWrap="true" Padding="0, 4, 0, 4" />
          <Graphic Content="res://ZuneShellResources!TaskbarPlayer.XP.HowTo.png" Margins="0, 4, 0, 4" />
        </Children>
      </Panel>
    </Content>
  </UI>
  <UI Name="ConfigureTaskbarOnVistaDialogContentUI" Base="dialog:DialogContentUI">
    <Properties>
      <managementGeneral:ConfigureTaskbarDialog Name="Dialog" ConfigureTaskbarDialog="$Required" />
    </Properties>
    <Locals>
      <util:TaskbarPlayer Name="TaskbarPlayer" TaskbarPlayer="{util:TaskbarPlayer.Instance}" />
      <iris:Command Name="EnableToolbarCommand" Description="{zuneUI:Shell.LoadString(zuneUI:StringId.IDS_TASKBAR_ENABLE_ON_VISTA)}" />
      <Timer Name="CloseDialogTimer" AutoRepeat="false" Interval="2000" Enabled="false" />
    </Locals>
    <Scripts>
      <Script><![CDATA[
DialogTitle = zuneUI:Shell.LoadString(zuneUI:StringId.IDS_TASKBAR_SETUP_ON_VISTA_TITLE);
ButtonCommands = new List();
ButtonCommands.Add(EnableToolbarCommand);
ButtonCommands.Add(Dialog.Close);
ButtonModelToFocus = EnableToolbarCommand;
DefaultButtonModel = EnableToolbarCommand;
if (TaskbarPlayer.EnableToolbar)
{
    Dialog.Close.Invoke();
}
]]></Script>
      <Script><![CDATA[
[DeclareTrigger(EnableToolbarCommand.Invoked)]
TaskbarPlayer.EnableToolbar = true;
EnableToolbarCommand.Available = false;
CloseDialogTimer.Start();
]]></Script>
      <Script><![CDATA[
[DeclareTrigger(CloseDialogTimer.Tick)]
Dialog.Close.Invoke();
]]></Script>
    </Scripts>
    <Content>
      <Panel Layout="VerticalFlow" MaximumSize="475, 0">
        <Children>
          <label:Label Content="{zuneUI:Shell.LoadString(zuneUI:StringId.IDS_TASKBAR_SETUP_ON_VISTA_DESC)}" Style="{styles:SharedStyles.DialogTextStyle}" WordWrap="true" Padding="0, 4, 0, 4" />
          <Graphic Content="res://ZuneShellResources!TaskbarPlayer.Vista.png" Margins="0, 4, 0, 4" />
        </Children>
      </Panel>
    </Content>
  </UI>
</UIX>